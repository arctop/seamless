<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Seamless launchd service (macOS user LaunchAgent).
  Placeholders __BINARY__ / __CONFIG__ / __LOG__ are substituted by `make install`, which
  renders this template to ~/Library/LaunchAgents/ and (re)loads it. Do not hand-edit the
  installed copy; re-run `make install` to update.

  This is the clone's copy. docs/install (the curl | sh path) inlines the same job because
  it is fetched alone, with no checkout to read a template out of -- keep the two in step.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.arctop.seamless</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BINARY__</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SEAMLESS_CONFIG</key>
    <string>__CONFIG__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__LOG__</string>
  <key>StandardErrorPath</key>
  <string>__LOG__</string>
</dict>
</plist>
