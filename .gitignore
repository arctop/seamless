# Binaries
/bin/
/dist/
# Sigstore bundles for the installer scripts: written by the release workflow
# before goreleaser runs. Untracked, they would leave the tree dirty and
# goreleaser refuses to release from a dirty tree.
/sigs/
/seamlessd
/seam
/docsgen
/seambench
*.exe
*.dll
*.so
*.dylib
# The Touch ID approver's SwiftPM output when built or tested in its own
# directory (make approver and approver-test keep theirs under bin/).
/macos/SeamApprove/.build/
/macos/SeamApprove/.swiftpm/

# Data / runtime state (SQLite + data-dir artifacts)
*.db
*.db-journal
*.db-wal
*.db-shm

# Config that may contain secrets (keep *.example, ignore the real ones)
seamless.yaml
seam-server.yaml

# Go build / test output
*.test
*.out
coverage.*
*.prof
vendor/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Python bytecode (scripts/branding/distill.py is the only Python in the tree)
__pycache__/
*.pyc

# Scratch / logs
tmp/
*.log
.mcp.json

# Claude Code local state (agent worktrees, local settings)
.claude/
